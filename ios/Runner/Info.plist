<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleDisplayName</key>
    <string>Kora</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>kora_messenger</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>$(FLUTTER_BUILD_NAME)</string>
    <key>CFBundleSignature</key>
    <string>????</string>
    <key>CFBundleVersion</key>
    <string>$(FLUTTER_BUILD_NUMBER)</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>UILaunchStoryboardName</key>
    <string>LaunchScreen</string>
    <key>UIMainStoryboardFile</key>
    <string>Main</string>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UIViewControllerBasedStatusBarAppearance</key>
    <false/>
    <key>CADisableMinimumFrameDurationOnPhone</key>
    <true/>
    <key>UIApplicationSupportsIndirectInputEvents</key>
    <true/>

    <!-- ═══ APPLE APP STORE COMPLIANCE: PERMISSION STRINGS ═══ -->

    <!-- Microphone — voice notes + live call translation (on-device) -->
    <key>NSMicrophoneUsageDescription</key>
    <string>Kora needs microphone access to record your voice notes and process live call translations completely on your device.</string>

    <!-- Local Network — WebRTC peer-to-peer encrypted calls -->
    <key>NSLocalNetworkUsageDescription</key>
    <string>Kora requires local network access to establish secure, end-to-end encrypted direct peer-to-peer connections for live calls.</string>

    <!-- Camera — video calls -->
    <key>NSCameraUsageDescription</key>
    <string>Kora needs camera access to make video calls and capture photos for your profile and chats.</string>

    <!-- Photo Library — media sharing -->
    <key>NSPhotoLibraryUsageDescription</key>
    <string>Kora needs photo library access to let you share images and videos in your chats.</string>

    <!-- Photo Library Add — save received media -->
    <key>NSPhotoLibraryAddUsageDescription</key>
    <string>Kora needs permission to save photos and videos you receive in chats to your photo library.</string>

    <!-- Contacts — find friends on Kora -->
    <key>NSContactsUsageDescription</key>
    <string>Kora needs contacts access to help you find friends who are already on Kora Messenger.</string>

    <!-- Face ID — app lock and authentication -->
    <key>NSFaceIDUsageDescription</key>
    <string>Kora uses Face ID to securely unlock the app and protect your private conversations.</string>

    <!-- Speech Recognition — voice-to-text -->
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>Kora uses speech recognition to transcribe your voice notes for on-device translation.</string>

    <!-- Bluetooth — wireless audio for calls -->
    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>Kora uses Bluetooth to connect wireless headphones and earbuds for voice and video calls.</string>

    <!-- Background Modes — VoIP and audio for calls -->
    <key>UIBackgroundModes</key>
    <array>
        <string>audio</string>
        <string>voip</string>
        <string>remote-notification</string>
        <string>fetch</string>
    </array>

    <!-- ITSAppUsesNonExemptEncryption — declares no custom encryption -->
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
</dict>
</plist>
