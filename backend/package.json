{
  "name": "kora-backend",
  "version": "1.0.0",
  "description": "Kora Messenger backend API (Node.js + Express + MongoDB Atlas). Domain-swappable: set KORA_BACKEND_URL in the app to this service's URL.",
  "main": "src/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mongoose": "^8.5.0",
    "nodemailer": "^10.0.0",
    "google-auth-library": "^9.11.0"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
