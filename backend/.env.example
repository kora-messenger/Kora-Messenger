# ── MongoDB Atlas ─────────────────────────────────────────────
# From Atlas: Connect → Drivers → copy the SRV connection string.
# Replace <password> with the database user's password.
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=kora

# ── Server ────────────────────────────────────────────────────
PORT=8080
# Shared secret the app sends (KORA_API_SECRET dart-define). Optional but recommended.
API_SECRET=

# ── Email (verification codes) ───────────────────────────────
# Any SMTP provider works. If empty, codes are logged to the server
# console instead of being emailed (dev mode).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Kora Messenger <no-reply@koramessenger.com>"
