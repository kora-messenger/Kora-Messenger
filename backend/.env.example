# Kora AI Server Environment
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file.

# OpenRouter API Key (required)
OPENROUTER_API_KEY=your_openrouter_key_here

# Default AI model (optional, defaults to "openrouter/free")
OPENROUTER_MODEL=openrouter/free

# Server auth token — the Android app sends this in the Authorization header.
# Generate a strong random token for production.
KORA_AUTH_TOKEN=change-me-in-production

# Server port (optional, defaults to 5000)
PORT=5000
