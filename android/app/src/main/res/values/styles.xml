<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Kora's native launch theme — matches the Flutter splash screen's
         deep black background so there's no white flash before the engine loads. -->
    <style name="Theme.KoraMessenger" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>
</resources>
